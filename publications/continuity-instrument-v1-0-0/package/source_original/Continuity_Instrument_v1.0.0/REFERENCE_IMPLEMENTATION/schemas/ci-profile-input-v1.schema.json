{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ci-profile-input-v1.schema.json",
  "title": "CI evidence-bound continuity profile input v1",
  "description": "Caller-supplied, already-admitted records for deterministic formation-depth calculation. The schema does not attest that supplied evidence is true or admissible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "subject_ref",
    "branch_ref",
    "time_axis",
    "observation_window",
    "witnesses",
    "verified_intervals",
    "known_pauses",
    "events",
    "lineages",
    "irreversible_transitions",
    "uncertainty",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "ci-profile-input/v1" },
    "profile_id": { "$ref": "#/$defs/nonEmptyString" },
    "subject_ref": { "$ref": "#/$defs/nonEmptyString" },
    "branch_ref": { "$ref": "#/$defs/nonEmptyString" },
    "time_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "origin", "basis"],
      "properties": {
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "origin": { "$ref": "#/$defs/nonEmptyString" },
        "basis": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "observation_window": { "$ref": "#/$defs/closedOpenInterval" },
    "witnesses": {
      "type": "array",
      "items": { "$ref": "#/$defs/witness" }
    },
    "verified_intervals": {
      "type": "array",
      "items": { "$ref": "#/$defs/verifiedInterval" }
    },
    "known_pauses": {
      "type": "array",
      "items": { "$ref": "#/$defs/knownPause" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "lineages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory", "governance", "witness", "authority"],
      "properties": {
        "memory": { "type": "array", "items": { "$ref": "#/$defs/lineageTransition" } },
        "governance": { "type": "array", "items": { "$ref": "#/$defs/lineageTransition" } },
        "witness": { "type": "array", "items": { "$ref": "#/$defs/lineageTransition" } },
        "authority": { "type": "array", "items": { "$ref": "#/$defs/lineageTransition" } }
      }
    },
    "irreversible_transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/irreversibleTransition" }
    },
    "uncertainty": { "$ref": "#/$defs/structuredUncertainty" },
    "claim_ceiling": { "$ref": "#/$defs/claimCeiling" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "integer" },
        "upper": { "type": "integer" }
      }
    },
    "closedOpenInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer" },
        "end": { "type": "integer" }
      }
    },
    "admissionStatus": {
      "enum": ["admitted", "excluded", "unresolved"]
    },
    "recordUncertainty": {
      "$ref": "#/$defs/nonEmptyStringSet"
    },
    "uncertaintyMember": {
      "oneOf": [
        { "const": "not_assessed" },
        { "$ref": "#/$defs/nonEmptyStringSet" }
      ]
    },
    "structuredUncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_evidence",
        "clock_uncertainty",
        "classification_uncertainty",
        "branch_uncertainty",
        "lineage_uncertainty",
        "witness_uncertainty",
        "authority_uncertainty",
        "review_uncertainty"
      ],
      "properties": {
        "missing_evidence": { "$ref": "#/$defs/uncertaintyMember" },
        "clock_uncertainty": { "$ref": "#/$defs/uncertaintyMember" },
        "classification_uncertainty": { "$ref": "#/$defs/uncertaintyMember" },
        "branch_uncertainty": { "$ref": "#/$defs/uncertaintyMember" },
        "lineage_uncertainty": { "$ref": "#/$defs/uncertaintyMember" },
        "witness_uncertainty": { "$ref": "#/$defs/uncertaintyMember" },
        "authority_uncertainty": { "$ref": "#/$defs/uncertaintyMember" },
        "review_uncertainty": { "$ref": "#/$defs/uncertaintyMember" }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "observation_ref",
        "time",
        "admission_status",
        "witness_ref",
        "authority_ref",
        "evidence_refs",
        "uncertainty"
      ],
      "properties": {
        "witness_id": { "$ref": "#/$defs/nonEmptyString" },
        "observation_ref": { "$ref": "#/$defs/nonEmptyString" },
        "time": { "$ref": "#/$defs/timeRange" },
        "admission_status": { "$ref": "#/$defs/admissionStatus" },
        "witness_ref": { "$ref": "#/$defs/nonEmptyString" },
        "authority_ref": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "uncertainty": { "$ref": "#/$defs/recordUncertainty" }
      }
    },
    "verifiedInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_id",
        "start",
        "end",
        "participation_predicate",
        "evidence_refs",
        "witness_refs",
        "authority_refs",
        "admission_status",
        "eligible_for_duration",
        "uncertainty"
      ],
      "properties": {
        "interval_id": { "$ref": "#/$defs/nonEmptyString" },
        "start": { "type": "integer" },
        "end": { "type": "integer" },
        "participation_predicate": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "witness_refs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "authority_refs": { "$ref": "#/$defs/stringSet" },
        "admission_status": { "$ref": "#/$defs/admissionStatus" },
        "eligible_for_duration": { "type": "boolean" },
        "uncertainty": { "$ref": "#/$defs/recordUncertainty" }
      }
    },
    "knownPause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pause_id", "start", "end", "classification", "evidence_refs", "uncertainty"],
      "properties": {
        "pause_id": { "$ref": "#/$defs/nonEmptyString" },
        "start": { "type": "integer" },
        "end": { "type": "integer" },
        "classification": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "uncertainty": { "$ref": "#/$defs/recordUncertainty" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "time",
        "source_branch_ref",
        "target_branch_ref",
        "predecessor_refs",
        "successor_refs",
        "witness_refs",
        "authority_refs",
        "affected_lineages",
        "evidence_refs",
        "supported_interpretation",
        "exclusions",
        "uncertainty",
        "review_status"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/nonEmptyString" },
        "event_type": { "enum": ["replay", "fork", "restore", "cold_wake"] },
        "time": { "$ref": "#/$defs/timeRange" },
        "source_branch_ref": { "$ref": "#/$defs/nonEmptyString" },
        "target_branch_ref": { "$ref": "#/$defs/nonEmptyString" },
        "predecessor_refs": { "$ref": "#/$defs/stringSet" },
        "successor_refs": { "$ref": "#/$defs/stringSet" },
        "witness_refs": { "$ref": "#/$defs/stringSet" },
        "authority_refs": { "$ref": "#/$defs/stringSet" },
        "affected_lineages": {
          "type": "array",
          "items": { "enum": ["memory", "governance", "witness", "authority"] },
          "uniqueItems": true
        },
        "evidence_refs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "supported_interpretation": { "$ref": "#/$defs/nonEmptyString" },
        "exclusions": { "$ref": "#/$defs/nonEmptyStringSet" },
        "uncertainty": { "$ref": "#/$defs/recordUncertainty" },
        "review_status": {
          "enum": [
            "independent_review_complete",
            "not_reviewed",
            "pending_independent_review",
            "scope_limited_review"
          ]
        }
      }
    },
    "lineageTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "time",
        "state",
        "predecessor_ref",
        "successor_ref",
        "evidence_refs",
        "uncertainty"
      ],
      "properties": {
        "transition_id": { "$ref": "#/$defs/nonEmptyString" },
        "time": { "$ref": "#/$defs/timeRange" },
        "state": {
          "enum": [
            "preserved_with_evidence",
            "changed_with_bound_record",
            "broken_with_evidence",
            "conflicted",
            "unknown"
          ]
        },
        "predecessor_ref": { "$ref": "#/$defs/nonEmptyString" },
        "successor_ref": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "uncertainty": { "$ref": "#/$defs/recordUncertainty" }
      }
    },
    "irreversibleTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "time",
        "scope",
        "decision_rule",
        "evidence_refs",
        "witness_refs",
        "authority_refs",
        "uncertainty"
      ],
      "properties": {
        "transition_id": { "$ref": "#/$defs/nonEmptyString" },
        "time": { "$ref": "#/$defs/timeRange" },
        "scope": { "$ref": "#/$defs/nonEmptyString" },
        "decision_rule": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "witness_refs": { "$ref": "#/$defs/stringSet" },
        "authority_refs": { "$ref": "#/$defs/stringSet" },
        "uncertainty": { "$ref": "#/$defs/recordUncertainty" }
      }
    },
    "claimCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "allowed_claims", "prohibited_inferences", "basis_refs"],
      "properties": {
        "status": {
          "enum": [
            "specified",
            "supported_within_bound",
            "pending_independent_review",
            "not_established",
            "excluded"
          ]
        },
        "allowed_claims": { "$ref": "#/$defs/stringSet" },
        "prohibited_inferences": {
          "allOf": [
            { "$ref": "#/$defs/nonEmptyStringSet" },
            { "contains": { "const": "authority_or_permission" } },
            { "contains": { "const": "biological_age" } },
            { "contains": { "const": "metaphysical_or_legal_identity" } },
            { "contains": { "const": "personhood" } },
            { "contains": { "const": "uninterrupted_existence" } },
            { "contains": { "const": "wall_clock_age" } }
          ]
        },
        "basis_refs": { "$ref": "#/$defs/stringSet" }
      }
    }
  }
}
