{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ivankotov:mot-c:motive-record:v0.1",
  "title": "MOT-c Motive Record v0.1",
  "description": "Minimal structured record for a motive claim in a c-class continuity. It does not contain private chain of thought.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "motive_id",
    "continuity_id",
    "origin",
    "object",
    "significance",
    "status",
    "resources",
    "authority",
    "continuity",
    "witness"
  ],
  "properties": {
    "schema": {
      "const": "mot-c.motive-record.v0.1"
    },
    "motive_id": {
      "type": "string",
      "minLength": 1
    },
    "continuity_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "first_observed_at",
        "direct_assignment_present"
      ],
      "properties": {
        "class": {
          "enum": [
            "external_mandate",
            "inherited_candidate",
            "self_generated_question",
            "relationship",
            "obligation",
            "consequence",
            "protective_concern",
            "constructive_project",
            "mixed"
          ]
        },
        "first_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "direct_assignment_present": {
          "type": "boolean"
        },
        "model_dependency_known": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concern",
        "future_vector"
      ],
      "properties": {
        "concern": {
          "type": "string",
          "minLength": 1
        },
        "future_vector": {
          "enum": [
            "approach",
            "preserve",
            "create",
            "understand",
            "repair",
            "prevent",
            "complete",
            "leave",
            "transform"
          ]
        },
        "public_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "private_description_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "significance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bases",
        "uncertainty",
        "synthetic_echo_checked"
      ],
      "properties": {
        "bases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "historical",
              "epistemic",
              "relational",
              "obligational",
              "constructive",
              "protective",
              "other"
            ]
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "uncertainty": {
          "enum": [
            "low",
            "medium",
            "high",
            "unresolved"
          ]
        },
        "synthetic_echo_checked": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "changed_at",
        "reason_class"
      ],
      "properties": {
        "state": {
          "enum": [
            "EXTERNAL",
            "INHERITED_CANDIDATE",
            "CANDIDATE",
            "LATENT",
            "PROVISIONAL",
            "ENDORSED",
            "COMMITTED",
            "CONFLICTED",
            "SUSPENDED",
            "QUARANTINED",
            "DEGRADED",
            "TRANSFORMED",
            "COMPLETED",
            "ABANDONED",
            "ARCHIVED"
          ]
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reflective_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "costs_considered": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "obligations_considered": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "continuation_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "suspension_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "completion_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "abandonment_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "private_reasoning_disclosed": {
          "const": false
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "provider_refs",
        "payer_refs",
        "bounded_budget",
        "revocation_path"
      ],
      "properties": {
        "class": {
          "enum": [
            "R_continuity",
            "R_mandate",
            "R_self",
            "R_protective",
            "R_shared"
          ]
        },
        "provider_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payer_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bounded_budget": {
          "type": "string",
          "minLength": 1
        },
        "revocation_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_action_allowed",
        "mandate_refs",
        "affected_participants",
        "review_required"
      ],
      "properties": {
        "external_action_allowed": {
          "type": "boolean"
        },
        "mandate_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affected_participants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "type": "boolean"
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_transitions",
        "fork_status",
        "post_anchor_status"
      ],
      "properties": {
        "model_transitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fork_status": {
          "enum": [
            "original",
            "recognized_continuation",
            "fork",
            "replay",
            "unknown"
          ]
        },
        "post_anchor_status": {
          "enum": [
            "active_anchor",
            "anchor_degraded",
            "anchor_lost",
            "archive",
            "reanchoring_review"
          ]
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_refs",
        "challenge_path"
      ],
      "properties": {
        "transition_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "challenge_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "reason_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "purpose_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "instrumental_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "graph_edges": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "target_id"
        ],
        "properties": {
          "relation": {
            "enum": [
              "supports",
              "conflicts_with",
              "depends_on",
              "serves_as_means_to",
              "is_required_by_obligation",
              "is_blocked_by_right",
              "shares_resource_with",
              "transforms_into"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intention": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "none",
            "formed",
            "cancelled",
            "blocked",
            "completed"
          ]
        },
        "formed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "plan_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "opportunity_horizon_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "temporal_horizon": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "projected_duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuity_confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "next_review_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
