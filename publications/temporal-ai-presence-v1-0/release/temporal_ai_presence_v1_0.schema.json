{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kot141078/advanced-global-intelligence/blob/main/publications/temporal-ai-presence-v1-0/release/temporal_ai_presence_v1_0.schema.json",
  "title": "Temporal AI Presence Profile v1.0 Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "title",
    "version",
    "status",
    "publication_status",
    "doi",
    "date",
    "canonical_definition",
    "primary_rule",
    "relation_invariant",
    "non_claims",
    "tap_classification",
    "memory_classes",
    "tool_privilege_classes",
    "states",
    "claim_classes",
    "conformance_classes",
    "evidence_classes",
    "mandatory_tests",
    "red_line_failures",
    "parent_corpus_relations",
    "downstream_corpus_relations",
    "provenance",
    "current_evidence_ceiling",
    "concept_doi",
    "t03_deployment_boundary",
    "public_local_evidence_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "./temporal_ai_presence_v1_0.schema.json"
    },
    "document_id": {
      "const": "Temporal_AI_Presence_Profile_v1_0"
    },
    "title": {
      "const": "Temporal AI Presence Profile v1.0"
    },
    "version": {
      "const": "1.0"
    },
    "status": {
      "const": "Standalone DOI deposit candidate"
    },
    "publication_status": {
      "const": "deposit-ready"
    },
    "doi": {
      "type": "null"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "canonical_definition": {
      "const": "Temporal AI Presence = sustained bounded AI participation across time."
    },
    "primary_rule": {
      "type": "string",
      "minLength": 40
    },
    "relation_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_valid_c_are_tap",
        "all_tap_are_c"
      ],
      "properties": {
        "all_valid_c_are_tap": {
          "const": true
        },
        "all_tap_are_c": {
          "const": false
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "tap_classification": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/classification"
      }
    },
    "memory_classes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/named_id"
      }
    },
    "tool_privilege_classes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/named_id"
      }
    },
    "states": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]+$"
      }
    },
    "claim_classes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^C-CLAIM-"
      }
    },
    "conformance_classes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TAP-"
      }
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EV-"
      }
    },
    "mandatory_tests": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "red_line_failures": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "parent_corpus_relations": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "downstream_corpus_relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "doi",
          "relation",
          "not_evidence_for"
        ],
        "properties": {
          "artifact": {
            "const": "MOT-c v0.1"
          },
          "doi": {
            "const": "10.5281/zenodo.22060517"
          },
          "relation": {
            "type": "string",
            "minLength": 20
          },
          "not_evidence_for": {
            "type": "array",
            "minItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "current_evidence_ceiling": {
      "type": "object"
    },
    "concept_doi": {
      "type": "null"
    },
    "t03_deployment_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "repository_owned_unresolved",
        "deployment_external_requirements",
        "categories",
        "claim"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "repository_owned_unresolved": {
          "const": 0
        },
        "deployment_external_requirements": {
          "const": 78
        },
        "categories": {
          "type": "object"
        },
        "claim": {
          "const": "TAP-T03 is publicly documented as partial with an explicit deployment-external boundary."
        }
      }
    },
    "public_local_evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_execution_is_public_evidence",
        "r2b_bundle_included",
        "public_immutable_code_reference_complete",
        "independent_external_replication_complete"
      ],
      "properties": {
        "local_execution_is_public_evidence": {
          "const": false
        },
        "r2b_bundle_included": {
          "const": false
        },
        "public_immutable_code_reference_complete": {
          "const": false
        },
        "independent_external_replication_complete": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "named_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "name": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tap",
        "rule"
      ],
      "properties": {
        "id": {
          "enum": [
            "TAP-0",
            "TAP-1",
            "TAP-2",
            "TAP-3",
            "TAP-4",
            "TAP-5",
            "TAP-6",
            "TAP-C",
            "TAP-X"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "tap": {
          "type": "boolean"
        },
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "requirement",
        "fail_condition",
        "minimum_evidence",
        "r0_evidence_status"
      ],
      "properties": {
        "id": {
          "pattern": "^TAP-T(0[1-9]|10)$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "requirement": {
          "type": "string",
          "minLength": 8
        },
        "fail_condition": {
          "type": "string",
          "minLength": 8
        },
        "minimum_evidence": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "r0_evidence_status": {
          "enum": [
            "PUBLIC_VERIFIED",
            "PUBLIC_CANDIDATE_NEEDS_EXECUTION",
            "SPECIFICATION_ONLY",
            "LOCAL_UNPUBLISHED_CANDIDATE",
            "NO_EVIDENCE_FOUND",
            "AMBIGUOUS"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "relation"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 2
        },
        "relation": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "provenance_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "commit",
        "path",
        "status"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "enum": [
            "CONCEPTUAL_PRECURSOR",
            "NORMATIVE_PROFILE"
          ]
        }
      }
    }
  }
}
